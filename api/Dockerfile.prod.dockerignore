# Per-Dockerfile ignore file for api/Dockerfile.prod (BuildKit convention:
# "<dockerfile-path>.dockerignore" at the context root overrides the plain
# .dockerignore for that specific build). This build's context is the repo
# root AND needs frontend/ (to build it in stage 1), unlike the dev
# api/Dockerfile, whose plain .dockerignore deliberately excludes frontend/
# entirely (it has its own separate build). Everything else mirrors the
# root .dockerignore.

.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

.git/
.gitignore

# Secrets: injected at runtime via env_file, never baked into an image layer.
.env

# Frontend: keep the source, exclude what npm ci/vite build regenerate.
frontend/node_modules/
frontend/dist/

# Regenerable data + runtime state (mounted at runtime instead, see
# docker-compose.prod.yml).
data/output/
data/insurance/output/
var/
evals/.last_run/

notebooks/
docs/
