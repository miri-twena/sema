# Copy this file to .env and adjust if needed. .env is gitignored -- it's
# your local configuration and should never be committed (especially once
# it contains real credentials).
#
# Defaults below match docker-compose.yml's local dev stack and work as-is.
# For a PRODUCTION deployment, see docs/deployment.md -- several of these
# (marked below) have a permissive dev default that api/main.py's startup
# check REQUIRES you to override when SEMA_ENV=production, and will refuse
# to boot otherwise.

# =============================================================================
# Deployment mode
# =============================================================================

# "dev" (default) or "production". Gates api/main.py's fail-fast startup
# checks and a few production-only behaviors (see docs/deployment.md). Leave
# unset/"dev" for local docker-compose.
SEMA_ENV=dev

# This deployment's own externally-reachable URL, e.g. "https://sema.example.com"
# (no trailing slash). Folded into the CORS allowlist automatically. REQUIRED
# in production; blank is fine in dev (SEMA_CORS_ORIGINS below already covers
# the Vite dev server).
SEMA_PUBLIC_URL=

# "mock" (default -- see sema_core/current_user.py; there is no real login
# yet) or "real" (not implemented yet -- auth_login_prompt.md Parts A+B,
# blocked until a real host exists). Declared explicitly so every deployment
# states its auth posture rather than relying on "mock" being the only option.
SEMA_AUTH_MODE=mock

# =============================================================================
# Postgres -- analytics databases (one per tenant, same container in dev)
# =============================================================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sema_user
# REQUIRED override in production -- the startup check refuses to boot with
# this exact default value.
POSTGRES_PASSWORD=sema_password

# Per-client database names. config/clients.yaml maps each client to the env
# var holding its DB name (db_env). Both DBs live in the same local container
# (same host/port/credentials) in dev; production may point these at
# separate managed Postgres instances instead.
POSTGRES_DB=sema_db                     # ecommerce client
POSTGRES_DB_INSURANCE=insurance_db      # insurance client

# Read-only role used by the SEMA agent's run_sql tool (see
# sql/create_readonly_role.sql). This login can only SELECT.
POSTGRES_READONLY_USER=sema_readonly
# REQUIRED override in production -- same reason as POSTGRES_PASSWORD above.
POSTGRES_READONLY_PASSWORD=sema_readonly_pw

# Max pooled connections kept open PER (client, role) -- e.g. 20 means up to
# 20 connections each for ecommerce's write role, ecommerce's readonly role,
# insurance's write role, etc. Raised from 5 (backend_qa_prompt.md's QA
# sweep measured 20 concurrent /api/chat requests exhausting a pool of 5);
# sized generously since sema_core/cache.py's single-flight ttl_cache now
# stops a burst of concurrent requests from each recomputing the same cold
# cache entry independently.
SEMA_DB_POOL_MAX=20

# =============================================================================
# Claude API (the agent)
# =============================================================================

# REQUIRED in production (the startup check refuses to boot without it).
# Leave blank in dev -- the app runs and shows "Claude API key is not
# configured yet." without it.
ANTHROPIC_API_KEY=

SEMA_MODEL=claude-sonnet-4-6
# Backup model tried automatically when the primary model API-errors
# (overloaded/5xx). Blank disables the fallback.
SEMA_MODEL_FALLBACK=claude-haiku-4-5-20251001
SEMA_MAX_ITERATIONS=8
SEMA_MAX_TOKENS=4000
# How many prior conversation turns are sent to the model on a follow-up.
SEMA_MAX_HISTORY_TURNS=10
# Approx. token budget for those prior turns (truncate_by_tokens).
SEMA_HISTORY_TOKEN_BUDGET=8000
SEMA_ANTHROPIC_TIMEOUT_S=60
SEMA_ANTHROPIC_MAX_RETRIES=2

# =============================================================================
# SQL safety
# =============================================================================

# Max rows a single run_sql call can return.
SEMA_ROW_LIMIT=1000
# Postgres statement_timeout for agent-issued queries, in milliseconds.
SEMA_STATEMENT_TIMEOUT_MS=5000

# =============================================================================
# API server
# =============================================================================

# Comma-separated allowlist for the browser frontend's CORS. The Vite dev
# server's two common ports are the default; SEMA_PUBLIC_URL above is added
# automatically on top of this list, so you don't need to repeat it here.
SEMA_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# X-API-Key value every request must send. Empty (the dev default) disables
# auth entirely. REQUIRED in production -- the startup check refuses to boot
# with this blank, since an empty value means the whole API has no
# authentication at all.
SEMA_API_KEY=

# Fernet key encrypting client-supplied DB credentials at rest (client_
# connections table, data_sources_add_prompt.md) -- generate one with:
#   .venv\Scripts\python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing/rotating this key makes every previously-stored connection
# unreadable (the admin must re-enter credentials); there is no recovery.
# REQUIRED in production (the startup check refuses to boot without a valid one).
SEMA_SECRETS_KEY=

# SQLite file backing conversations, org users/settings, semantic drafts,
# audit log, home config, alerts, uploads metadata, etc. -- see docs/
# deployment.md for why this path MUST be on a persistent volume in production.
SEMA_CONVERSATION_DB=var/sema_state.db

# Disables the background daily conversation-retention sweep. Leave on
# (default) unless you have a specific reason to turn it off.
SEMA_RETENTION_ENABLED=true

# Per-(client, org_user) soft cap on /api/chat + /api/chat/stream calls per
# UTC calendar day -- a cost guardrail against a runaway script or a
# compromised session hammering the billed Anthropic API, not a usage
# ration. 0 disables the cap entirely.
SEMA_DAILY_QUERY_LIMIT=200

# Startup client (id from config/clients.yaml). The app can switch clients at
# runtime from the admin page; this only sets which one is active on first load.
SEMA_CLIENT=ecommerce

# =============================================================================
# Data sources
# =============================================================================

# Service-account email shown in the Google Sheets connector's "share this
# sheet with..." instructions. Leave blank in local dev -- the flow still
# works, it just lands the source in "setting up" state awaiting platform
# configuration instead of validating access immediately.
SEMA_GSHEETS_SA_EMAIL=

# =============================================================================
# Email (reserved -- not read by any code yet)
# =============================================================================

# Placeholders for auth_login_prompt.md Part A's one-time email code
# delivery, once that's unblocked. Nothing in this codebase reads these yet;
# they're documented now so the env-var contract for the very next piece of
# work is already visible.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
